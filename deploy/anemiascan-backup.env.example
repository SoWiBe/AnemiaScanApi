# Копировать в /etc/anemiascan-backup.env, заполнить, chmod 600.
# Файл содержит пароль от базы — в git он не попадает.

# Пользователь с ролью backup/readWrite на базе приложения.
MONGO_URI=mongodb://backup:ПАРОЛЬ@127.0.0.1:27017/SmartAnemiaScan?authSource=SmartAnemiaScan

# Где складываются архивы до выгрузки.
BACKUP_DIR=/var/backups/anemiascan

# Сколько дней держать локальные копии.
RETENTION_DAYS=14

# Имя боевой базы — используется restore-check.
SOURCE_DB=SmartAnemiaScan

# Куда уезжает копия. ОБЯЗАТЕЛЬНО за пределы этого сервера.
# При хостинге в РК ради локализации персданных приёмник тоже должен быть в РК.
#   второй сервер:      rsync://backup@10.0.0.2:/srv/backups/anemiascan/
#   S3-совместимое КЗ:  s3://anemiascan-backups/mongo/
REMOTE_TARGET=rsync://backup@ВТОРОЙ_СЕРВЕР:/srv/backups/anemiascan/

# Имя remote в конфиге rclone — нужно только для варианта s3://
RCLONE_REMOTE=kzstorage
